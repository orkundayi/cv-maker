rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User documents - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // CV subcollection - users can only access their own CVs
      match /cvs/{cvId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subscription subcollection
      match /subscription/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Only cloud functions can write subscription data (for payment processing)
        allow write: if false;
      }
    }
    
    // Public templates - everyone can read
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false; // Only admin can write
    }
    
    // Subscription plans - everyone can read
    match /plans/{planId} {
      allow read: if true;
      allow write: if false; // Only admin can write
    }
  }
}
